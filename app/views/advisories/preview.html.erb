<div id="rubymem">
  <%= render :partial => "shared/header" %>
  <section>

    <div class="col-sm-6">
      <h3>Advisory form</h3>
      <%= render :partial => "form", :locals => { :presenter => @presenter, :preview_label => "Update preview" } %>
    </div>


    <div class="col-sm-6">
      <h3>Advisory YAML</h3>
      <p>Here is what you submission will look like. Please revise, and edit it if anything looks out of place.</p>
      <pre>
<%= @preview %>
      </pre>

      <p><strong>Your email:</strong> <%= @advisory.submitter_email %></p>
      <p>If you know what you're doing, feel free to submit the above directly as a pull request to the <a href="https://github.com/rubymem/ruby-mem-advisory-db">GitHub repository</a>.</p>
      <p>Nothing has been saved yet. When this looks right, hit "Submit for review"
      on the left and we will store it and email the reviewers.</p>
    </div>

  </section>
</div>
